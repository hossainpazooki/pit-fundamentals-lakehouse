# WS1 Airflow orchestration -- copy to `.env` for local use (`.env` itself is
# gitignored; this template is tracked). Dev-only defaults below -- never
# commit real secrets. These credentials sit behind localhost:8080 only, on
# a stack with no outward-facing exposure; treat any change away from these
# defaults as still dev-only, not a substitute for real secret handling.

# Linux only (sets bind-mount file ownership inside the containers);
# harmless placeholder on Windows -- Docker Desktop's Windows bind-mount
# layer doesn't use this the same way.
AIRFLOW_UID=50000

AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Dev-only admin login for the Airflow UI at http://localhost:8080. Change
# these if you're not comfortable with the default, but there is nothing
# beyond this login guarding the stack -- do not expose port 8080 outside
# localhost with these credentials still set.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Used by dags/vantage_pipeline.py to build the spark-submit docker-run
# mounts/paths and pick the Spark sibling image. Windows paths use forward
# slashes -- Docker Desktop's bind-mount spec parsing wants POSIX-style
# separators even on a Windows host.
VANTAGE_REPO_PATH=C:/Users/hossa/dev/vantage
VANTAGE_DATA_PATH=C:/Users/hossa/dev/vantage-data
VANTAGE_SPARK_IMAGE=apache/spark:3.5.3-scala2.12-java17-python3-ubuntu
# Container-internal path (once /vantage is mounted read-only into every
# Airflow service AND the DockerOperator passes the same mount into the
# Spark sibling container).
VANTAGE_JAR_PATH=/vantage/target/scala-2.12/vantage-assembly-0.1.0.jar
